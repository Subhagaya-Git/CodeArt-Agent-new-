# =============================================================================
# ShopHub — root environment template
# =============================================================================
# Copy this file to .env and fill in real values:  cp .env.example .env
#
# For `docker compose up --build` the ONLY variable read from this root file is
# JWT_SECRET (interpolated by docker-compose.yml). Every other variable below is
# already injected into the right container by the `environment:` block in
# docker-compose.yml and is listed here as a reference catalogue.
#
# For local (non-Docker) development, each service and the frontend have their
# own .env.example — copy those into per-folder .env files as well.
# =============================================================================

# ---- Shared (read by docker-compose.yml from this file) ---------------------
# Secret used to sign/verify JWTs. MUST be identical across auth/product/cart/
# order services. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string

# ---- Gateway (services/gateway) --------------------------------------------
PORT_GATEWAY=4000
AUTH_SERVICE_URL=http://auth-service:4001
PRODUCT_SERVICE_URL=http://product-service:4002
CART_SERVICE_URL=http://cart-service:4003
ORDER_SERVICE_URL=http://order-service:4004
REDIS_URL=redis://redis:6379

# ---- Auth Service (services/auth-service) ----------------------------------
PORT_AUTH=4001
MONGO_URI_AUTH=mongodb://mongodb:27017/auth_db?replicaSet=rs0

# ---- Product Service (services/product-service) ----------------------------
PORT_PRODUCT=4002
MONGO_URI_PRODUCT=mongodb://mongodb:27017/product_db?replicaSet=rs0

# ---- Cart Service (services/cart-service) ----------------------------------
PORT_CART=4003
MONGO_URI_CART=mongodb://mongodb:27017/cart_db?replicaSet=rs0

# ---- Order Service (services/order-service) --------------------------------
PORT_ORDER=4004
MONGO_URI_ORDER=mongodb://mongodb:27017/order_db?replicaSet=rs0

# ---- Frontend (frontend, Vite build arg) -----------------------------------
# Public URL the browser uses to reach the gateway. For Docker it is baked in at
# image build time via docker-compose.yml `build.args`.
VITE_API_URL=http://localhost:4000
