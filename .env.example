# =============================================================================
# ShopHub — root environment template
# =============================================================================
# Copy this file to .env and fill in real values:  cp .env.example .env
#
# For `docker compose up --build` the variables below are interpolated by
# docker-compose.yml. Each service also has its own .env.example for running it
# directly (non-Docker). Never commit a real .env — it is gitignored.
#
# Generate strong secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# =============================================================================

# ---- Secrets (shared) -------------------------------------------------------
# JWT signing secret. MUST be identical across auth/product/cart/order services.
JWT_SECRET=replace_with_a_long_random_secret_string
# Shared key for service-to-service calls (gateway -> services). >= 16 chars.
INTERNAL_API_KEY=replace_with_a_long_random_internal_key

# ---- CORS -------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
CLIENT_ORIGIN=http://localhost:5173

# ---- Default admin (used to seed the first admin user) ----------------------
# docker-compose.yml applies dev defaults. In production set NODE_ENV=production
# and provide strong values (ADMIN_PASSWORD >= 12 chars).
ADMIN_EMAIL=admin@shophub.com
ADMIN_PASSWORD=change_this_admin_password

# ---- Gateway (services/gateway) --------------------------------------------
PORT_GATEWAY=4000
AUTH_SERVICE_URL=http://auth-service:4001
PRODUCT_SERVICE_URL=http://product-service:4002
CART_SERVICE_URL=http://cart-service:4003
ORDER_SERVICE_URL=http://order-service:4004
REDIS_URL=redis://redis:6379

# ---- Auth Service (services/auth-service) ----------------------------------
PORT_AUTH=4001
MONGO_URI_AUTH=mongodb://mongodb:27017/auth_db?replicaSet=rs0

# ---- Product Service (services/product-service) ----------------------------
PORT_PRODUCT=4002
MONGO_URI_PRODUCT=mongodb://mongodb:27017/product_db?replicaSet=rs0

# ---- Cart Service (services/cart-service) ----------------------------------
PORT_CART=4003
MONGO_URI_CART=mongodb://mongodb:27017/cart_db?replicaSet=rs0

# ---- Order Service (services/order-service) --------------------------------
PORT_ORDER=4004
MONGO_URI_ORDER=mongodb://mongodb:27017/order_db?replicaSet=rs0

# ---- Frontend (frontend, Vite build arg) -----------------------------------
# Public URL the browser uses to reach the gateway. For Docker it is baked in at
# image build time via docker-compose.yml `build.args`.
VITE_API_URL=http://localhost:4000

# ---- Docker secrets (optional) ---------------------------------------------
# As an alternative to plain env vars, secrets can be mounted as files. See
# docker-compose.secrets.yml for an opt-in overlay. When using it, the services
# read from these file paths instead:
#   JWT_SECRET_FILE, INTERNAL_API_KEY_FILE, ADMIN_PASSWORD_FILE
