PORT=4001
MONGO_URI=mongodb://localhost:27017/auth_db
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string
# Shared key for service-to-service calls. >= 16 chars.
INTERNAL_API_KEY=replace_with_a_long_random_internal_key
CLIENT_ORIGIN=http://localhost:5173
REDIS_URL=redis://localhost:6379
# Seed admin user. Dev fallbacks apply when unset; required (= strong) in production.
ADMIN_EMAIL=admin@shophub.com
ADMIN_PASSWORD=change_this_admin_password
# Optional: read secrets from files instead of env vars.
# JWT_SECRET_FILE=/run/secrets/jwt_secret
# INTERNAL_API_KEY_FILE=/run/secrets/internal_api_key
# ADMIN_PASSWORD_FILE=/run/secrets/admin_password
