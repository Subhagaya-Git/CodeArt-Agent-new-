PORT=4002
MONGO_URI=mongodb://localhost:27017/product_db
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string
# Shared key for service-to-service calls. >= 16 chars.
INTERNAL_API_KEY=replace_with_a_long_random_internal_key
CLIENT_ORIGIN=http://localhost:5173
# Optional: read secrets from files instead of env vars.
# JWT_SECRET_FILE=/run/secrets/jwt_secret
# INTERNAL_API_KEY_FILE=/run/secrets/internal_api_key
